# Supabase Database URL (Transaction Connection Pooler - Port 6543)
# Tìm thấy tại: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Database URL (Session / Direct Connection - Port 5432 - Dùng cho Prisma Migrations)
# Tìm thấy tại: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Session)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Mật khẩu quản trị Dashboard Admin (dùng để đăng nhập trang /admin)
ADMIN_SECRET_KEY="TiktokFarmSecretAdmin2026!#"

# Domain chính của website (Dùng cho SEO, Canonical, OpenGraph, Sitemap)
NEXT_PUBLIC_SITE_URL="https://shortsfarm.vercel.app"

# URL cài đặt phần mềm dự phòng (nếu trong DB chưa có release)
NEXT_PUBLIC_DEFAULT_DOWNLOAD_URL="https://github.com/your-repo/tiktok-farm/releases/latest/download/ShortsFarm_Setup_v1.0.0.exe"

# Link video YouTube hướng dẫn / demo trực quan
NEXT_PUBLIC_YOUTUBE_DEMO_URL="https://www.youtube.com/watch?v=dQw4w9WgXcQ"

# =========================================================================
# CỔNG THANH TOÁN VIETQR TỰ ĐỘNG CHO CÁ NHÂN (payOS / SePay / VietQR)
# =========================================================================

# 1. payOS (Khuyên dùng - Đăng ký miễn phí bằng CCCD cá nhân tại https://payos.vn)
PAYOS_CLIENT_ID="your_payos_client_id"
PAYOS_API_KEY="your_payos_api_key"
PAYOS_CHECKSUM_KEY="your_payos_checksum_key"

# 2. SePay / Casso (Nếu bạn dùng webhook SePay tại https://sepay.vn)
SEPAY_API_KEY=""

# 3. Thông tin ngân hàng cá nhân hiển thị trên mã VietQR (Dự phòng nếu chưa bật payOS)
VIETQR_BANK_ID="MB"                # MB, VCB, TCB, ACB, VPB, TPB, ICB...
VIETQR_ACCOUNT_NO="0988888888"     # Số tài khoản ngân hàng cá nhân của bạn
VIETQR_ACCOUNT_NAME="NGUYEN VAN A" # Tên chủ tài khoản viết hoa không dấu

# 4. Gửi email biên nhận tự động qua Nodemailer (Khuyên dùng Gmail App Password - Miễn phí 100%)
# Cách tạo mật khẩu Gmail: Google Account -> Security (Bảo mật) -> 2-Step Verification -> App Passwords (Mật khẩu ứng dụng)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="ShortsFarm Studio <your-email@gmail.com>"

# (Tùy chọn) Hoặc dùng Resend API nếu có:
RESEND_API_KEY=""

