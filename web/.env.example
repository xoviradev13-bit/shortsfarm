# Supabase Database URL (Transaction Connection Pooler - Port 6543)
# Tìm thấy tại: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Database URL (Session / Direct Connection - Port 5432 - Dùng cho Prisma Migrations)
# Tìm thấy tại: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Session)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Mật khẩu quản trị Dashboard Admin (dùng để đăng nhập trang /admin)
ADMIN_SECRET_KEY="TiktokFarmSecretAdmin2026!#"

# URL cài đặt phần mềm dự phòng (nếu trong DB chưa có release)
NEXT_PUBLIC_DEFAULT_DOWNLOAD_URL="https://github.com/your-repo/tiktok-farm/releases/latest/download/TikTokFarm_Setup.exe"

